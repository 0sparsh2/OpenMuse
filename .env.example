# OpenMuse configuration — copy to .env (gitignored) and fill in.
# Only the first block is required; everything else is optional.

# --- Required: the model (NVIDIA NIM, OpenAI-compatible) -----------------------
NVIDIA_NIM_API_KEY=nvapi-...
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1

# --- Optional: models for specific jobs (default: NVIDIA_MODEL) -----------------
# NVIDIA_FALLBACK_MODEL=openai/gpt-oss-20b      # used when the main model keeps failing
# NVIDIA_MEMORY_MODEL=                          # background memory extraction (thinking off)
# NVIDIA_VOICE_MODEL=                           # voice turns (thinking off, streamed)
# NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b # memory recall + search passage ranking

# --- Optional: apps (Gmail, Google Calendar) via Composio -----------------------
# COMPOSIO_API_KEY=ak_...
# OPENMUSE_PUBLIC_URL=http://127.0.0.1:8080     # where OAuth returns after connecting

# --- Optional: Jev (TypeSafe AI) fast decisions ---------------------------------
# Picks which search results to open, "search again?", the search router, and page
# checks in the live browser. Without it, embeddings and rules are used instead.
# JEV_API_KEY=...

# --- Optional: voice --------------------------------------------------------------
# Speech uses NVIDIA Riva on NIM with the same NVIDIA_NIM_API_KEY by default.
# OPENMUSE_VOICE=off                            # disable server speech (browser speech only)
# OPENMUSE_ASR_MODEL=whisper                    # whisper | parakeet
# OPENMUSE_TTS_VOICE=
# Or any OpenAI-compatible /audio endpoints instead:
# OPENMUSE_STT_BASE=  OPENMUSE_STT_KEY=  OPENMUSE_STT_MODEL=whisper-1
# OPENMUSE_TTS_BASE=  OPENMUSE_TTS_KEY=  OPENMUSE_TTS_MODEL=tts-1

# --- Optional: behaviour ----------------------------------------------------------
# OPENMUSE_AUTONOMY=off        # ask before every step (default: reversible local steps run on their own)
# OPENMUSE_HEADFUL=1           # show the automation browser window on this machine
# OPENMUSE_API_PORT=8765
# OPENMUSE_DATA=.data/api      # shared workspace root (per-user data lives under .data/)

# --- Optional: keys for encryption and push (generated into .data/ if unset) ------
# OPENMUSE_VAULT_KEY=          # Fernet key for saved logins
# VAPID_PUBLIC_KEY=  VAPID_PRIVATE_KEY=  VAPID_SUBJECT=mailto:you@example.com

# --- Written automatically on first start (keep it; the UI uses it) -----------------
# OPENMUSE_API_KEY=omk_...
