{
  "name": "OpenMuse",
  "short_name": "OpenMuse",
  "description": "Your personal agent — chat, browse, remember, and get things done.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f5fa",
  "theme_color": "#1d4ed8",
  "categories": ["productivity", "utilities"],
  "icons": [
    {"src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "New chat", "url": "/?source=shortcut", "icons": [{"src": "/icons/icon-192.png", "sizes": "192x192"}]}
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{"name": "files", "accept": ["image/*", "application/pdf", "text/*", ".pdf", ".txt", ".md", ".csv", ".docx", ".xlsx"]}]
    }
  }
}
